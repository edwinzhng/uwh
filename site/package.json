{
	"name": "calgary-crocs-site",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "bun run check:design && next build",
		"start": "next start --port 3001",
		"typecheck": "tsc --noEmit",
		"check:design": "bun scripts/check-design-boundary.ts && bun run check:motion",
		"lint": "biome check . && bun run check:design",
		"test": "bun test",
		"check": "bun run typecheck && bun run lint && bun test",
		"check:motion": "bun scripts/check-motion-tokens.ts"
	},
	"dependencies": {
		"@calgarycrocs/design-system": "file:../packages/design-system",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@vercel/analytics": "^2.0.1",
		"convex": "^1.32.0",
		"jotai": "^2.18.0",
		"next": "16.3.3",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"typescript": "^5"
	}
}
