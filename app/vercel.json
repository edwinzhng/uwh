{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bun run build:web",
	"outputDirectory": "dist",
	"cleanUrls": true,
	"bunVersion": "1.x",
	"redirects": [
		{ "source": "/uwh-club", "destination": "/support", "permanent": true },
		{
			"source": "/uwh-club/privacy",
			"destination": "/privacy",
			"permanent": true
		},
		{ "source": "/uwh-club/terms", "destination": "/terms", "permanent": true }
	],
	"rewrites": [
		{
			"source": "/api/auth/:path*",
			"destination": "https://brainy-albatross-874.convex.site/api/auth/:path*"
		}
	],
	"headers": [
		{
			"source": "/api/auth/:path*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-store"
				}
			]
		}
	]
}
