{
	"name": "crocs-club",
	"version": "0.1.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"web": "expo start --web",
		"preview": "bun scripts/preview.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
